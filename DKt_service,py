"""Deep Knowledge Tracing (LSTM) inference.

Loads the checkpoint saved by the notebook (lstm_model.pt) plus skill_meta.json
(written by export_for_app.py). Given a student's answer history, returns the
predicted probability of a correct answer for every skill.

Skill names must match the SkillBuilder skill_id values the model was trained on.
"""
import json
import os

import torch
import torch.nn as nn

MAX_LEN = 200  # same truncation length used in training


class DKT(nn.Module):
    # Mirrors the notebook class. The head is inferred from forward(); load_state_dict
    # (strict) will fail loudly if the checkpoint was trained with a different shape.
    def __init__(self, num_skills, hidden=64):
        super().__init__()
        self.num_skills = num_skills
        self.num_tokens = 2 * num_skills
        self.lstm = nn.LSTM(self.num_tokens, hidden, batch_first=True)
        self.head = nn.Linear(hidden, num_skills)

    def forward(self, tokens):  # tokens: (batch, time) of skill + num_skills * correct
        x = nn.functional.one_hot(tokens, self.num_tokens).float()
        out, _ = self.lstm(x)
        return self.head(out)  # (batch, time, num_skills): P(correct next time) logits


class DKTPredictor:
    def __init__(self, model_dir):
        with open(os.path.join(model_dir, "skill_meta.json"), encoding="utf-8") as f:
            meta = json.load(f)
        self.skill_names = meta["skill_names"]
        self.skill_index = {s: i for i, s in enumerate(self.skill_names)}
        self.prior = meta["prior_correct"]
        self.metrics = meta.get("metrics", {})
        self.model = DKT(len(self.skill_names))
        state = torch.load(os.path.join(model_dir, "lstm_model.pt"), map_location="cpu")
        self.model.load_state_dict(state)
        self.model.eval()

    def next_probs(self, history):
        """history: list of (skill_name, correct) with correct in {0, 1}, oldest first.
        Returns {skill_name: P(correct)} for every skill the model knows."""
        items = [(self.skill_index[s], int(c)) for s, c in history if s in self.skill_index]
        if not items:
            return {s: self.prior for s in self.skill_names}
        items = items[-MAX_LEN:]
        tokens = torch.tensor([[k + len(self.skill_names) * c for k, c in items]], dtype=torch.long)
        with torch.no_grad():
            logits = self.model(tokens)[0, -1]
            probs = torch.sigmoid(logits).numpy()
        return {s: float(probs[i]) for i, s in enumerate(self.skill_names)}

    def skill_mastery(self, history, skills):
        """Predicted P(correct) for the given skills only, e.g. the skills in one lesson."""
        probs = self.next_probs(history)
        return {s: probs[s] for s in skills if s in probs}